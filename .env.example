# Application
NODE_ENV=development
PORT=3001

# CORS — comma-separated list of allowed frontend origins (no trailing slash)
# Production example: https://rentai.tn,https://www.rentai.tn
CORS_ORIGINS=http://localhost:3000,http://localhost:3001


# Database (Prisma format)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rental_platform?schema=public

# Legacy TypeORM variables (for reference, will be removed)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=rental_platform

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production
REFRESH_TOKEN_EXPIRES_IN=7d


# ML Service
ML_SERVICE_URL=http://localhost:8000

# Upload
UPLOAD_DIR=uploads

# Commission
COMMISSION_PERCENTAGE=0.10

# Throttle
THROTTLE_TTL=60
THROTTLE_LIMIT=10
THROTTLE_AUTH_LIMIT=5
THROTTLE_BOOKING_LIMIT=10

# AI (OpenAI) - for future use
OPENAI_API_KEY=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
AI_MODEL=gpt-4o-mini
AI_MAX_FOLLOWUPS=1

# Image classification (ImageClassifierService).
# Pick ONE provider and set its key:
#   1) Gemini (free tier, recommended): GEMINI_API_KEY=AIza...
#   2) Groq (uses GROQ_API_KEY above, free tier): set GROQ_VISION_MODEL below
#   3) Real OpenAI (paid): set OPENAI_API_KEY=sk-... AND clear OPENAI_BASE_URL
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Cloudinary (for image uploads in production — required on Railway)
CLOUDINARY_CLOUD_NAME=dzsa61iqo
CLOUDINARY_API_KEY=865899695783262
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ── Payment providers ─────────────────────────────────────────────────────────
# Set PAYMENT_PROVIDER to the key of the active provider (flouci | konnect | d17 | stripe)
PAYMENT_PROVIDER=konnect

# Stripe (test mode) — hosted Checkout redirect, works on localhost (no tunnel).
# Get your test secret key at https://dashboard.stripe.com/test/apikeys
# Test card: 4242 4242 4242 4242, any future expiry, any CVC.
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key
# Presentment currency. Most Stripe accounts can't present TND — use usd or eur.
STRIPE_CURRENCY=usd

# Flouci
FLOUCI_APP_TOKEN=
FLOUCI_APP_SECRET=
FLOUCI_BASE_URL=https://developers.flouci.com

# Konnect
# Sandbox credentials: register at https://sandbox.konnect.network → Settings → API Keys
# KONNECT_ENV must be "sandbox" for dev and "prod" for production
# KONNECT_RECEIVER_WALLET_ID: your wallet ID shown in the Konnect dashboard
# BACKEND_PUBLIC_URL: must be publicly reachable for webhooks (use ngrok in dev):
#   npx ngrok http 3001  → copy the https URL, e.g. https://abc123.ngrok-free.app
#   Then set: BACKEND_PUBLIC_URL=https://abc123.ngrok-free.app
#   Webhooks land at: BACKEND_PUBLIC_URL/api/payments/konnect/webhook  (bookings)
#                     BACKEND_PUBLIC_URL/api/wallet/konnect/webhook      (wallet top-ups)
KONNECT_ENV=sandbox
KONNECT_API_BASE_URL=https://api.sandbox.konnect.network/api/v2
KONNECT_API_KEY=your_konnect_api_key
KONNECT_RECEIVER_WALLET_ID=your_receiver_wallet_id
BACKEND_PUBLIC_URL=https://your-public-backend-url
FRONTEND_PUBLIC_URL=http://localhost:3000

# ── Error monitoring (Sentry) ─────────────────────────────────────────────────
# Optional. Leave blank to disable — the backend runs fine with no DSN and
# reports nothing. Paste the DSN from your Sentry project (Settings → Client Keys)
# to start capturing 5xx server errors in production.
SENTRY_DSN=
# Overrides the environment tag shown in Sentry (defaults to NODE_ENV).
SENTRY_ENV=
# Optional release/version tag for grouping errors by deploy.
APP_VERSION=

# Simulated wallet top-up (dev only)
# Set to "true" ONLY in local dev to show the fake-money injection UI on /client/wallet.
# Must be "false" (or unset) in production — the backend also blocks it when NODE_ENV=production.
NEXT_PUBLIC_ENABLE_SIMULATED_TOPUP=false

# ── PRODUCTION (Railway) ──────────────────────────────────────────────────────
# Set these as Railway env vars (NOT committed to git):
# DATABASE_URL=<railway-auto-provided>
# JWT_SECRET=<strong-64-char-random>
# REFRESH_TOKEN_SECRET=<strong-64-char-random>
# JWT_REFRESH_SECRET=<strong-64-char-random>
# CORS_ORIGINS=https://your-vercel-app.vercel.app
# NODE_ENV=production
# CLOUDINARY_API_SECRET=<your-real-secret>
