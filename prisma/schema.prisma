// This is the Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===========================
// User Model
// ===========================
model User {
  id              String    @id @default(uuid())
  name            String    @db.VarChar(255)
  email           String?   @unique @db.VarChar(255)
  phone           String?   @unique @db.VarChar(20)
  // Nullable because OAuth-only users (Google etc.) never set a local password
  passwordHash    String?   @map("password_hash") @db.VarChar(255)
  googleId        String?   @unique @map("google_id") @db.VarChar(255)
  avatarUrl       String?   @db.VarChar(500)
  roles           String[]  @default(["user"])
  isHost          Boolean   @default(false)
  verifiedEmail   Boolean   @default(false)
  verifiedPhone   Boolean   @default(false)
  ratingAvg       Decimal   @default(0) @db.Decimal(3, 2)
  ratingCount     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  suspendedAt     DateTime? @map("suspended_at")
  trustReviewedAt DateTime? @map("trust_reviewed_at")
  manualTrustTier String?   @map("manual_trust_tier") @db.VarChar(50)
  homeLat         Float?    @map("home_lat")
  homeLng         Float?    @map("home_lng")
  homeCityName    String?   @map("home_city_name") @db.VarChar(255)

  // Quality score (0..100). Recomputed by QualityScoreService on relevant
  // events (new booking accepted, review created) and nightly by cron.
  // Higher score = better search ranking + visible "Top host" badge.
  qualityScore    Int       @default(0) @map("quality_score")
  qualityUpdatedAt DateTime? @map("quality_updated_at")

  // Renter trust score (0..100). Mirrors qualityScore but with renter-side
  // signals: completed bookings, host reviews of this renter, late-cancel
  // history, disputes opened by hosts, KYC, account age. High scorers get
  // a "Trusted renter" badge that hosts see when accepting requests, plus
  // future-instant-book eligibility.
  renterTrustScore   Int       @default(0) @map("renter_trust_score")
  renterTrustUpdatedAt DateTime? @map("renter_trust_updated_at")

  // Host KYC: uploaded ID document URL + admin review state. Renter-facing
  // UIs check `idVerifiedAt IS NOT NULL` to show the "Verified host" badge.
  idDocumentUrl   String?   @map("id_document_url") @db.VarChar(500)
  idSubmittedAt   DateTime? @map("id_submitted_at")
  idVerifiedAt    DateTime? @map("id_verified_at")
  idVerifiedBy    String?   @map("id_verified_by")
  idRejectedAt    DateTime? @map("id_rejected_at")
  idRejectionReason String? @map("id_rejection_reason") @db.VarChar(500)

  // Personalization: 768-d Gemini embedding averaged from listings this user
  // has interacted with (booked / wishlisted / messaged / reviewed / viewed),
  // weighted by signal strength and recency. Recomputed by PersonalizationService
  // on strong signals (booking, wishlist, review) and nightly for the rest.
  preferenceVector          Float[]   @default([]) @map("preference_vector")
  preferenceVectorUpdatedAt DateTime? @map("preference_vector_updated_at")

  // Relations
  listings               Listing[]
  bookingsAsRenter       Booking[]       @relation("RenterBookings")
  bookingsAsHost         Booking[]       @relation("HostBookings")
  reviewsWritten         Review[]        @relation("ReviewAuthor")
  reviewsReceived        Review[]        @relation("ReviewTarget")
  adminLogs              AdminLog[]
  paymentIntentsAsRenter PaymentIntent[] @relation("RenterPayments")
  paymentIntentsAsHost   PaymentIntent[] @relation("HostPayments")

  // Chat relations
  renterConversations        Conversation[]              @relation("RenterConversations")
  hostConversations          Conversation[]              @relation("HostConversations")
  sentMessages               Message[]
  chatbotConversations       ChatConversation[]          @relation("UserChatbotConversations")
  chatbotActionConfirmations ChatbotActionConfirmation[] @relation("UserActionConfirmations")
  chatbotSecurityEvents      ChatbotSecurityEvent[]      @relation("UserChatbotSecurityEvents")
  payoutsAsHost              Payout[]                    @relation("HostPayouts")
  categoryRequests           CategoryRequest[]           @relation("RequesterCategoryRequests")
  wallet                     Wallet?
  verificationCodes          VerificationCode[]          @relation("UserVerificationCodes")
  passwordResetTokens        PasswordResetToken[]        @relation("UserPasswordResetTokens")
  refreshTokens              RefreshToken[]              @relation("UserRefreshTokens")
  wishlistItems              WishlistItem[]              @relation("UserWishlist")
  disputesOpened             Dispute[]                   @relation("DisputeOpener")
  disputeMessages            DisputeMessage[]            @relation("DisputeMessageAuthor")
  notifications              Notification[]              @relation("UserNotifications")
  topUpIntents               TopUpIntent[]               @relation("UserTopUpIntents")
  interactions               UserInteraction[]           @relation("UserInteractions")

  @@index([email])
  @@index([phone])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(255)

  user User @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ===========================
// WhatsApp Concierge
// ===========================
// A lightweight per-phone-number conversation log used by the WhatsApp bot.
// Stores the last search context so a follow-up like "the second one" can be
// resolved against the previous reply. Tied to a User only when we can match
// the phone number — otherwise the conversation is anonymous.
model WishlistItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  listingId String   @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation("UserWishlist", fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation("ListingWishlist", fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
  @@map("wishlist_items")
}

model WhatsappConversation {
  id              String   @id @default(uuid())
  phoneNumber     String   @unique @map("phone_number") @db.VarChar(32)
  userId          String?  @map("user_id")
  lastQuery       String?  @map("last_query") @db.Text
  lastResultIds   String[] @map("last_result_ids")
  lastFilters     Json?    @map("last_filters") @db.JsonB
  lastMessageAt   DateTime @default(now()) @map("last_message_at")
  messageCount    Int      @default(0) @map("message_count")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([lastMessageAt])
  @@map("whatsapp_conversations")
}

// ===========================
// In-app notifications
// ===========================
// One row per actionable in-app event for a user. The bell icon shows the
// unread count; clicking an entry opens the linked URL. We deliberately keep
// the column shape small — heavy data lives in `payload` JSON for evolution
// without schema migrations.
//
// `kind` is a short opaque string ("BOOKING_REQUESTED", "DISPUTE_RESOLVED",
// etc.) — the frontend uses it to pick an icon + colour. Keep new kinds
// stable; client may not know about brand-new ones until you ship a UI.
model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  kind      String    @db.VarChar(64)
  title     String    @db.VarChar(255)
  body      String?   @db.Text
  link      String?   @db.VarChar(500)
  payload   Json?     @db.JsonB
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  ipAddress  String?   @map("ip_address") @db.VarChar(64)

  user User @relation("UserPasswordResetTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ===========================
// Category Request Model
// ===========================
enum CategoryRequestStatus {
  PENDING
  APPROVED
  REJECTED
  MERGED
}

model CategoryRequest {
  id                 String                @id @default(uuid())
  requesterId        String                @map("requester_id")
  proposedName       String                @map("proposed_name") @db.VarChar(255)
  reason             String?               @db.Text
  status             CategoryRequestStatus @default(PENDING)
  adminNotes         String?               @map("admin_notes") @db.Text
  resolvedCategoryId String?               @map("resolved_category_id")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  requester        User      @relation("RequesterCategoryRequests", fields: [requesterId], references: [id])
  resolvedCategory Category? @relation("ResolvedCategory", fields: [resolvedCategoryId], references: [id])

  @@map("category_requests")
}

// ===========================
// Category Model
// ===========================
model Category {
  id                String   @id @default(uuid())
  name              String   @db.VarChar(255)
  slug              String   @unique @db.VarChar(255)
  icon              String?  @db.VarChar(100)
  allowedForPrivate Boolean  @default(true) @map("allowed_for_private")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now())

  // Relations
  listings         Listing[]
  categoryRequests CategoryRequest[] @relation("ResolvedCategory")

  @@index([slug], name: "idx_category_slug")
  @@index([isActive])
  @@map("categories")
}

// ===========================
// Listing Model
// ===========================
enum BookingType {
  DAILY
  SLOT
}

enum CancellationPolicy {
  FLEXIBLE
  MODERATE
  STRICT
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
}

model Listing {
  id           String                               @id @default(uuid())
  hostId       String
  title        String                               @db.VarChar(255)
  description  String                               @db.Text
  categoryId   String
  images       String[]
  pricePerDay  Decimal                              @db.Decimal(10, 2)
  location     Unsupported("geometry(Point,4326)")?
  address      String                               @db.VarChar(500)
  rules        String?                              @db.Text
  availability Json?                                @db.JsonB
  isActive     Boolean                              @default(true)
  status       ListingStatus                        @default(PENDING_REVIEW)
  bookingType  BookingType                          @default(DAILY)
  // Calendar: minimum nights per booking (Airbnb-style) and an optional
  // external iCal feed URL the host syncs from (Airbnb/Booking.com export).
  minNights     Int                                 @default(1) @map("min_nights")
  icalImportUrl String?                             @map("ical_import_url") @db.VarChar(500)
  nearBeach       Boolean?                          @map("near_beach")
  propertyType    String?                           @map("property_type") @db.VarChar(50)
  guestsCapacity  Int?                              @map("guests_capacity")
  bedrooms        Int?                              @map("bedrooms")
  ratingAvg       Float                             @default(0) @map("rating_avg")
  bookingCount30d Int                               @default(0) @map("booking_count_30d")
  qualityScore    Int                               @default(0) @map("quality_score")
  qualityUpdatedAt DateTime?                        @map("quality_updated_at")
  // Host-chosen refund rules for this listing. Surfaced on the detail page
  // and used by CancellationPolicyService to compute refund amounts.
  cancellationPolicy CancellationPolicy             @default(MODERATE) @map("cancellation_policy")

  // Smart Pricing: when true, DynamicPricingService nudges pricePerDay daily
  // within ±30% of basePricePerDay based on demand signals. basePricePerDay
  // snapshots the host's original price so we can always recover and explain
  // "where the price came from".
  dynamicPricing   Boolean   @default(false) @map("dynamic_pricing")
  basePricePerDay  Decimal?  @map("base_price_per_day") @db.Decimal(10, 2)
  dynamicPricingAt DateTime? @map("dynamic_pricing_at")

  // Personalization: 768-d Gemini embedding of title + description, used to
  // score similarity against user preference vectors. Persisted (not in-memory)
  // so it survives restarts and avoids re-embedding on every recommend call.
  embedding          Float[]   @default([])
  embeddingUpdatedAt DateTime? @map("embedding_updated_at")

  deletedAt     DateTime?
  createdAt     DateTime                            @default(now())
  updatedAt     DateTime                            @updatedAt

  // Relations
  host              User                 @relation(fields: [hostId], references: [id])
  category          Category             @relation(fields: [categoryId], references: [id])
  bookings          Booking[]
  reviews           Review[]
  conversations     Conversation[]
  slotConfiguration SlotConfiguration?
  wishlistedBy      WishlistItem[]       @relation("ListingWishlist")
  priceAdjustments  PriceAdjustmentLog[]
  interactions      UserInteraction[]    @relation("ListingInteractions")
  availabilityBlocks ListingAvailabilityBlock[]
  datePrices         ListingDatePrice[]

  @@index([pricePerDay])
  @@index([categoryId])
  @@index([isActive])
  @@index([status])
  @@index([deletedAt])
  @@index([hostId])
  @@map("listings")
}

// ===========================
// Host availability blocks (Airbnb-style calendar)
// ===========================
// A host-created "unavailable" window on a DAILY listing's calendar — e.g.
// the host is using the apartment themselves, or it's under maintenance.
// Distinct from bookings: blocks carry no money and no renter. The renter
// calendar greys these out alongside real bookings, and the booking-conflict
// check rejects any reservation overlapping a block. endDate is EXCLUSIVE,
// matching the booking date convention (a block Jan 1→Jan 5 covers Jan 1-4).
model ListingAvailabilityBlock {
  id        String   @id @default(uuid())
  listingId String   @map("listing_id")
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  note      String?  @db.VarChar(255)
  // "manual" = host blocked it here; "ical" = imported from an external feed
  // (re-sync wipes & recreates only the ical rows, never manual ones).
  source      String  @default("manual") @map("source") @db.VarChar(16)
  externalUid String? @map("external_uid") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, startDate, endDate])
  @@index([listingId, source])
  @@map("listing_availability_blocks")
}

// ===========================
// Per-date price overrides (Airbnb-style custom nightly pricing)
// ===========================
// One row per (listing, calendar day) where the host set a price different
// from the listing's base pricePerDay — e.g. weekends or peak season. The
// booking total sums each night's effective price (override ?? base).
model ListingDatePrice {
  id        String   @id @default(uuid())
  listingId String   @map("listing_id")
  date      DateTime @db.Date
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@index([listingId, date])
  @@map("listing_date_prices")
}

// ===========================
// User-Listing Interactions
// ===========================
// Tracks every signal of intent (view → wishlist → message → booking → review)
// per user-listing pair. The PersonalizationService averages embeddings of
// recently-interacted listings — weighted by signal strength and recency — to
// build each user's preference vector. Old rows (>90 days) are pruned nightly.
enum InteractionKind {
  VIEW
  WISHLIST_ADD
  WISHLIST_REMOVE
  MESSAGE
  BOOKING
  REVIEW
}

model UserInteraction {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  listingId String          @map("listing_id")
  kind      InteractionKind
  weight    Float           @default(1)
  createdAt DateTime        @default(now()) @map("created_at")

  user    User    @relation("UserInteractions", fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation("ListingInteractions", fields: [listingId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([listingId, createdAt])
  @@index([userId, kind])
  @@map("user_interactions")
}

// ===========================
// Booking Model
// ===========================
enum BookingStatus {
  pending
  confirmed
  paid
  completed
  cancelled
  rejected
}

enum DisputeStatus {
  NONE
  OPEN
  RESOLVED
}

enum DisputeReason {
  NOT_AS_DESCRIBED   // Item didn't match the listing
  DAMAGED            // Renter found it damaged on arrival, or host claims damage on return
  NO_SHOW            // Other party didn't show up
  CANCELLED_LATE     // Cancelled too close to start
  PAYMENT_ISSUE      // Money/refund issue
  OTHER
}

enum DisputeResolution {
  PENDING                // not yet resolved
  REFUND_FULL            // renter gets 100% back
  REFUND_PARTIAL         // renter gets the recorded amount back
  FAVOR_HOST             // host keeps everything
  DISMISSED              // not actionable / out of policy
}

enum DisputeOpenedBy {
  RENTER
  HOST
}

model Booking {
  id        String   @id @default(uuid())
  listingId String
  renterId  String
  hostId    String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  // Slot-specific fields (null for DAILY bookings)
  startTime DateTime? @db.Time
  endTime   DateTime? @db.Time

  totalPrice  Decimal       @db.Decimal(10, 2)
  commission  Decimal       @db.Decimal(10, 2)
  status      BookingStatus @default(pending)
  paid        Boolean       @default(false)
  paymentInfo Json?         @db.JsonB
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Immutable snapshot: captured at booking creation, never updated
  snapshotTitle          String?  @db.VarChar(255)
  snapshotPricePerDay    Decimal? @db.Decimal(10, 2)
  snapshotCommissionRate Decimal? @db.Decimal(5, 4)
  snapshotCurrency       String?  @default("TND") @db.VarChar(3)

  // Dispute
  disputeStatus DisputeStatus @default(NONE)

  // Abandoned-booking nudges. We send one reminder after 4h pending, then a
  // "last chance" after 24h. These columns track delivery so the cron never
  // double-sends; null = not yet sent.
  pendingReminderSentAt      DateTime? @map("pending_reminder_sent_at")
  pendingFinalReminderSentAt DateTime? @map("pending_final_reminder_sent_at")

  // Relations
  listing       Listing        @relation(fields: [listingId], references: [id])
  renter        User           @relation("RenterBookings", fields: [renterId], references: [id])
  host          User           @relation("HostBookings", fields: [hostId], references: [id])
  reviews       Review[]
  paymentIntent PaymentIntent?
  ledgerEntries LedgerEntry[]
  Conversation  Conversation[]
  disputes      Dispute[]

  @@index([startDate, endDate])
  @@index([status])
  @@index([listingId, startDate, startTime, endTime])
  @@map("bookings")
}

// ===========================
// Dispute model
// ===========================
// A formal complaint about a paid/completed booking. Opening a dispute
// flips Booking.disputeStatus → OPEN, which makes the booking ineligible
// for host payout until an admin resolves it. Each dispute has a timeline
// of DisputeMessage rows so renter, host, and admin can communicate
// without leaving the platform.
model Dispute {
  id          String            @id @default(uuid())
  bookingId   String            @map("booking_id")
  openedById  String            @map("opened_by_id")
  openedBy    DisputeOpenedBy   @map("opened_by_role")
  reason      DisputeReason
  description String            @db.Text
  status      DisputeStatus     @default(OPEN)
  resolution  DisputeResolution @default(PENDING)
  // Refund amount the admin decided on (only meaningful when resolution
  // is REFUND_PARTIAL or REFUND_FULL). Always in the booking's currency.
  refundAmount Decimal?         @map("refund_amount") @db.Decimal(10, 2)
  resolvedById String?          @map("resolved_by_id")
  resolvedAt   DateTime?        @map("resolved_at")
  resolverNotes String?         @map("resolver_notes") @db.Text
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  booking  Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  opener   User             @relation("DisputeOpener", fields: [openedById], references: [id])
  messages DisputeMessage[]

  @@index([bookingId])
  @@index([status])
  @@index([openedById])
  @@map("disputes")
}

model DisputeMessage {
  id          String   @id @default(uuid())
  disputeId   String   @map("dispute_id")
  authorId    String   @map("author_id")
  // True when the author is an admin acting on the case (vs a participant).
  isAdmin     Boolean  @default(false) @map("is_admin")
  body        String   @db.Text
  // Image evidence (Cloudinary URLs in prod, /uploads/... in dev). Empty
  // for plain-text messages.
  attachments String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  author  User    @relation("DisputeMessageAuthor", fields: [authorId], references: [id])

  @@index([disputeId])
  @@map("dispute_messages")
}

// ===========================
// Review Model
// ===========================
enum ReviewAuthorRole {
  RENTER
  HOST
}

enum ReviewType {
  RENTER_TO_HOST
  HOST_TO_RENTER
}

model Review {
  id           String           @id @default(uuid())
  bookingId    String
  authorId     String
  authorRole   ReviewAuthorRole @default(RENTER) @map("author_role")
  targetUserId String
  listingId    String
  type         ReviewType
  rating       Int
  comment      String?    @db.Text
  createdAt    DateTime   @default(now())

  // Relations
  booking    Booking @relation(fields: [bookingId], references: [id])
  author     User    @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetUser User    @relation("ReviewTarget", fields: [targetUserId], references: [id])
  listing    Listing @relation(fields: [listingId], references: [id])

  @@unique([bookingId, authorId])
  @@index([targetUserId])
  @@index([listingId])
  @@map("reviews")
}

// ===========================
// AdminLog Model
// ===========================
model AdminLog {
  id        String   @id @default(uuid())
  action    String   @db.VarChar(255)
  actorId   String
  details   Json?    @db.JsonB
  createdAt DateTime @default(now())

  // Relations
  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([createdAt])
  @@map("admin_logs")
}

// ===========================
// PaymentIntent Model
// ===========================
enum PaymentIntentStatus {
  created
  authorized
  captured
  refunded
  cancelled
}

model PaymentIntent {
  id          String              @id @default(uuid())
  bookingId   String              @unique
  renterId    String
  hostId      String
  amount      Decimal             @db.Decimal(10, 2)
  currency    String              @default("TND") @db.VarChar(3)
  status      PaymentIntentStatus @default(created)
  metadata    Json?               @db.JsonB
  // Real-money provider integration. `provider` is null for simulated payments,
  // 'flouci' / 'konnect' / 'd17' for real ones. `providerRef` is the external
  // payment id we get back from the gateway; we use it to verify callbacks.
  provider    String?             @db.VarChar(32)
  providerRef String?             @unique @map("provider_ref") @db.VarChar(128)
  redirectUrl String?             @map("redirect_url") @db.VarChar(500)
  paidAt      DateTime?           @map("paid_at")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  // Relations
  booking       Booking       @relation(fields: [bookingId], references: [id])
  renter        User          @relation("RenterPayments", fields: [renterId], references: [id])
  host          User          @relation("HostPayments", fields: [hostId], references: [id])
  ledgerEntries LedgerEntry[]

  @@index([bookingId])
  @@index([status])
  @@index([renterId])
  @@map("payment_intents")
}

// ===========================
// Chat Models
// ===========================
model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Participants
  renterId String
  hostId   String
  renter   User   @relation("RenterConversations", fields: [renterId], references: [id])
  host     User   @relation("HostConversations", fields: [hostId], references: [id])

  // Optional: Link to booking or listing
  bookingId String?
  listingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])
  listing   Listing? @relation(fields: [listingId], references: [id])

  // Messages in this conversation
  messages Message[]

  // Metadata
  lastMessageAt DateTime?

  @@unique([renterId, hostId, bookingId])
  @@index([renterId])
  @@index([hostId])
  @@index([bookingId])
  @@index([listingId])
  @@map("conversations")
}

model Message {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Content (already masked at write time if anti-leak fired)
  content String @db.Text

  // Sender
  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  // Conversation
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Read status
  readAt DateTime?

  // Anti-leak: true when the original message had a phone/email/social handle
  // that we masked before persisting. `contactLeakKinds` lists what we matched
  // (e.g. ["phone","social"]) — useful for spotting repeat offenders.
  contactLeak      Boolean  @default(false) @map("contact_leak")
  contactLeakKinds String[] @default([]) @map("contact_leak_kinds")

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@index([contactLeak])
  @@map("messages")
}

// ===========================
// Slot Configuration Model
// ===========================
model SlotConfiguration {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Associated listing
  listingId String  @unique
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Slot settings
  slotDurationMinutes Int // e.g., 60 for 1-hour slots
  operatingHours      Json @db.JsonB // { "monday": { "start": "08:00", "end": "22:00" }, ... }
  minBookingSlots     Int  @default(1) // Minimum slots to book
  maxBookingSlots     Int? // Maximum slots per booking
  bufferMinutes       Int  @default(0) // Buffer time between bookings

  // Pricing
  pricePerSlot Decimal @db.Decimal(10, 2)

  @@index([listingId])
  @@map("slot_configurations")
}

// ===========================
// AI Search Log
// ===========================
model AiSearchLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  query         String
  lat           Float?
  lng           Float?
  radiusKm      Float?
  followUpAsked Boolean @default(false)
  mode          String // 'FOLLOW_UP' | 'RESULT'
  filters       Json    @db.JsonB
  resultsCount  Int     @default(0)

  @@index([createdAt])
  @@map("ai_search_logs")
}

// ===========================
// AI Price Suggestion Log
// ===========================
model PriceSuggestionLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  city            String  @db.VarChar(255)
  categorySlug    String  @map("category_slug") @db.VarChar(100)
  unit            String  @db.VarChar(50)
  season          String? @db.VarChar(50)
  propertyType    String? @map("property_type") @db.VarChar(50)
  distanceToSeaKm Float?  @map("distance_to_sea_km")
  capacity        Int?
  lat             Float?
  lng             Float?

  suggestedPrice Decimal @map("suggested_price") @db.Decimal(10, 2)
  rangeMin       Decimal @map("range_min") @db.Decimal(10, 2)
  rangeMax       Decimal @map("range_max") @db.Decimal(10, 2)
  confidence     String  @db.VarChar(10)
  compsCity      Int     @map("comps_city")
  compsNational  Int     @map("comps_national")
  wCity          Float   @map("w_city")
  wNational      Float   @map("w_national")

  inputJson   Json  @map("input_json") @db.JsonB
  outputJson  Json  @map("output_json") @db.JsonB
  adjustments Json? @db.JsonB
  explanation Json  @db.JsonB

  listingId  String?  @map("listing_id")
  finalPrice Decimal? @map("final_price") @db.Decimal(10, 2)
  overridden Boolean?

  @@index([createdAt])
  @@index([city, categorySlug], map: "ai_price_suggestion_logs_city_category_slug_idx")
  @@index([listingId], map: "ai_price_suggestion_logs_listing_id_idx")
  @@map("ai_price_suggestion_logs")
}

// ===========================
// Dynamic pricing audit log
// ===========================
// One row per Smart-Pricing adjustment. Surfaced to hosts ("here's why your
// price moved") and used by the founder dashboard to track lift.
model PriceAdjustmentLog {
  id            String   @id @default(uuid())
  listingId     String   @map("listing_id")
  oldPrice      Decimal  @map("old_price") @db.Decimal(10, 2)
  newPrice      Decimal  @map("new_price") @db.Decimal(10, 2)
  basePrice     Decimal  @map("base_price") @db.Decimal(10, 2)
  multiplier    Decimal  @db.Decimal(5, 4)
  factors       Json     @db.JsonB
  reason        String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@map("price_adjustment_logs")
}

// ===========================
// Ledger Models
// ===========================
enum LedgerEntryType {
  RENT_PAID
  COMMISSION
  HOST_PAYOUT_DUE
  REFUND
  ADJUSTMENT
  HOST_PAYOUT
  WALLET_TOP_UP
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum LedgerStatus {
  POSTED
  REVERSED
}

model LedgerEntry {
  id              String          @id @default(uuid())
  bookingId       String?
  paymentIntentId String?
  actorId         String?
  type            LedgerEntryType
  direction       LedgerDirection
  amount          Decimal         @db.Decimal(10, 2)
  currency        String          @default("TND") @db.VarChar(3)
  status          LedgerStatus    @default(POSTED)
  reversedEntryId String?         @unique
  metadata        Json?           @db.JsonB
  createdAt       DateTime        @default(now())

  // Relations
  booking           Booking?           @relation(fields: [bookingId], references: [id])
  paymentIntent     PaymentIntent?     @relation(fields: [paymentIntentId], references: [id])
  reversedEntry     LedgerEntry?       @relation("Reversal", fields: [reversedEntryId], references: [id])
  reversedBy        LedgerEntry?       @relation("Reversal")
  payoutItem        PayoutItem?
  walletTransaction WalletTransaction?

  @@index([bookingId])
  @@index([paymentIntentId])
  @@index([type])
  @@index([createdAt])
  @@map("ledger_entries")
}

// ===========================
// Payout Models
// ===========================
enum PayoutStatus {
  PENDING
  PAID
  CANCELLED
}

model Payout {
  id        String       @id @default(uuid())
  hostId    String
  amount    Decimal      @db.Decimal(10, 2)
  currency  String       @default("TND") @db.VarChar(3)
  status    PayoutStatus @default(PENDING)
  method    String?      @db.VarChar(100)
  reference String?      @db.VarChar(255)
  notes     String?      @db.Text
  createdAt DateTime     @default(now())
  paidAt    DateTime?
  adminId   String? // who created/approved

  host  User         @relation("HostPayouts", fields: [hostId], references: [id])
  items PayoutItem[]

  @@index([hostId])
  @@index([status])
  @@index([createdAt])
  @@map("payouts")
}

model PayoutItem {
  id            String   @id @default(uuid())
  payoutId      String
  ledgerEntryId String   @unique
  createdAt     DateTime @default(now())

  payout      Payout      @relation(fields: [payoutId], references: [id])
  ledgerEntry LedgerEntry @relation(fields: [ledgerEntryId], references: [id])

  @@index([payoutId])
  @@map("payout_items")
}

// ===========================
// Chatbot Models
// ===========================
model ChatConversation {
  id        String   @id @default(uuid())
  userId    String
  title     String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User                        @relation("UserChatbotConversations", fields: [userId], references: [id])
  messages            ChatMessage[]
  summary             ChatConversationSummary?
  actionConfirmations ChatbotActionConfirmation[]
  securityEvents      ChatbotSecurityEvent[]

  @@index([userId])
  @@map("chat_conversations")
}

model ChatConversationSummary {
  id                   String   @id @default(uuid())
  conversationId       String   @unique
  summaryText          String   @db.Text
  lastMessageIdCovered String?  @db.VarChar(255)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("chat_conversation_summaries")
}

model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String   @db.VarChar(50) // user | assistant | tool | system
  content        String   @db.Text
  toolName       String?  @db.VarChar(255)
  toolPayload    Json?    @db.JsonB
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("chat_messages")
}

// ===========================
// Chatbot Mutation Flow
// ===========================
model ChatbotActionConfirmation {
  id             String    @id @default(uuid())
  userId         String
  conversationId String
  actionName     String    @db.VarChar(255)
  resourceType   String?   @db.VarChar(255)
  resourceId     String?   @db.VarChar(255)
  payload        Json?     @db.JsonB
  payloadHash    String    @db.VarChar(255)
  token          String    @unique @db.VarChar(255)
  status         String    @default("pending") @db.VarChar(50) // pending | confirmed | expired | consumed | cancelled
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  consumedAt     DateTime?

  user         User             @relation("UserActionConfirmations", fields: [userId], references: [id])
  conversation ChatConversation @relation(fields: [conversationId], references: [id])

  @@index([token])
  @@index([userId, conversationId])
  @@map("chatbot_action_confirmations")
}

// ===========================
// Chatbot Trust & Abuse Subsystem
// ===========================
model ChatbotSecurityEvent {
  id             String   @id @default(uuid())
  userId         String
  conversationId String?
  eventType      String   @db.VarChar(100) // e.g. 'rate_limit_exceeded', 'suspicious_payload', 'confirmation_replay'
  severity       String   @db.VarChar(50) // 'low', 'medium', 'high', 'critical'
  reasonCode     String   @db.VarChar(255)
  metadata       Json?    @db.JsonB
  createdAt      DateTime @default(now())

  user         User              @relation("UserChatbotSecurityEvents", fields: [userId], references: [id])
  conversation ChatConversation? @relation(fields: [conversationId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("chatbot_security_events")
}

// ===========================
// Wallet Models
// ===========================
enum WalletTransactionType {
  TOP_UP
  PAYMENT
  REFUND
  ADJUSTMENT
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Decimal  @default(0.00) @db.Decimal(10, 2)
  currency  String   @default("TND") @db.VarChar(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]

  @@map("wallets")
}

enum VerificationChannel {
  EMAIL
  PHONE
}

model VerificationCode {
  id          String              @id @default(uuid())
  userId      String              @map("user_id")
  channel     VerificationChannel
  destination String              @db.VarChar(255)
  codeHash    String              @map("code_hash") @db.VarChar(255)
  expiresAt   DateTime            @map("expires_at")
  consumedAt  DateTime?           @map("consumed_at")
  attempts    Int                 @default(0)
  createdAt   DateTime            @default(now()) @map("created_at")

  user User @relation("UserVerificationCodes", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel])
  @@index([expiresAt])
  @@map("verification_codes")
}

model WalletTransaction {
  id            String                @id @default(uuid())
  walletId      String
  amount        Decimal               @db.Decimal(10, 2)
  balanceBefore Decimal               @db.Decimal(10, 2)
  balanceAfter  Decimal               @db.Decimal(10, 2)
  type          WalletTransactionType
  referenceId   String?               @db.VarChar(255)
  ledgerEntryId String?               @unique
  createdAt     DateTime              @default(now())

  wallet      Wallet       @relation(fields: [walletId], references: [id])
  ledgerEntry LedgerEntry? @relation(fields: [ledgerEntryId], references: [id])

  @@index([walletId])
  @@index([createdAt])
  @@map("wallet_transactions")
}

// ===========================
// TopUpIntent Model
// Tracks Konnect wallet top-up sessions, separate from booking PaymentIntents.
// ===========================
model TopUpIntent {
  id          String    @id @default(uuid())
  userId      String
  amount      Decimal   @db.Decimal(10, 2)
  currency    String    @default("TND") @db.VarChar(3)
  status      String    @default("pending") @db.VarChar(32)
  provider    String    @default("konnect") @db.VarChar(32)
  providerRef String?   @unique @map("provider_ref") @db.VarChar(128)
  redirectUrl String?   @map("redirect_url") @db.VarChar(500)
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now())

  user User @relation("UserTopUpIntents", fields: [userId], references: [id])

  @@index([userId])
  @@map("top_up_intents")
}
